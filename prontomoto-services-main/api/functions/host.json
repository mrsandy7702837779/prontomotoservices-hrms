{
  "version": "2.0",
  "extensions": {
    "http": {
      "routePrefix": "api",
      "cors": {
        "allowedOrigins": [
          "http://localhost:3000",
          "http://127.0.0.1:3000"
        ],
        "allowedMethods": [ "GET", "POST", "DELETE", "OPTIONS" ],
        "allowedHeaders": [ "*" ],
        "supportCredentials": false
      }
    }
  }
}
